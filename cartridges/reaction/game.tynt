{
  "format": "tynt",
  "version": 1,
  "title": "reaction",
  "author": "tynt",
  "description": "Wait for the signal, then measure your reaction time in deterministic frames.",
  "controls": "A or B reacts · A or B starts the next round",
  "source": "let state = \"waiting\";\nlet startedAt = 0;\nlet cueAt = 0;\nlet result = 0;\nlet round = 0;\n\nfunction startRound(): void {\n  round++;\n  startedAt = frame();\n  cueAt = startedAt + Math.floor(random(90, 241));\n  result = 0;\n  state = \"waiting\";\n}\n\nexport function init(): void {\n  seed(60);\n  startRound();\n}\n\nexport function update(): void {\n  const pressed = buttonPressed(\"a\") || buttonPressed(\"b\");\n  if (state === \"result\" || state === \"early\") {\n    if (pressed) startRound();\n    return;\n  }\n  if (state === \"waiting\" && pressed) {\n    state = \"early\";\n    sfx([180, 110], 85, 0.09, \"triangle\");\n    return;\n  }\n  if (state === \"waiting\" && after(cueAt)) {\n    state = \"go\";\n    tone(760, 70, 0.1);\n    return;\n  }\n  if (state === \"go\" && pressed) {\n    result = frame() - cueAt;\n    state = \"result\";\n    sfx([440, 660, 880], 55, 0.09);\n  }\n}\n\nexport function draw(): void {\n  clear(0);\n  text(\"REACTION\", 57, 14, 3);\n  text(\"ROUND \" + round, 65, 27, 1);\n  if (state === \"waiting\") {\n    circle(80, 70, 22, 1, false);\n    text(\"WAIT\", 72, 67, 2);\n  }\n  if (state === \"go\") {\n    circle(80, 70, every(4) ? 24 : 20, 3, true);\n    text(\"GO\", 76, 67, 0);\n  }\n  if (state === \"early\") {\n    text(\"TOO EARLY\", 59, 62, 3);\n    text(\"A/B AGAIN\", 60, 78, 2);\n  }\n  if (state === \"result\") {\n    text(String(result) + \" FRAMES\", 61, 62, 3);\n    text(Math.round(result * 1000 / 60) + \" MS\", 65, 74, 2);\n    text(\"A/B AGAIN\", 60, 90, 1);\n  }\n}\n",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
