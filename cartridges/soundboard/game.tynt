{
  "format": "tynt",
  "version": 1,
  "title": "soundboard",
  "source": "let label = \"PRESS A OR B\";\nlet flash = 0;\n\nexport function init(): void {}\n\nexport function update(): void {\n  if (buttonPressed(\"a\")) {\n    tone(440, 120, 0.14, \"square\");\n    label = \"A  440 HZ\";\n    flash = 12;\n  }\n  if (buttonPressed(\"b\")) {\n    sfx([262, 330, 392, 523], 75, 0.12, \"triangle\");\n    label = \"B  ARPEGGIO\";\n    flash = 24;\n  }\n  if (buttonReleased(\"a\")) label = \"A RELEASED\";\n  if (buttonReleased(\"b\")) label = \"B RELEASED\";\n  flash = clamp(flash - 1, 0, 24);\n}\n\nexport function draw(): void {\n  clear(0);\n  text(\"SOUNDBOARD\", 58, 18, 3);\n  circle(52, 70, 20, button(\"a\") ? 3 : 1, true);\n  circle(108, 70, 20, button(\"b\") ? 3 : 2, true);\n  text(\"A\", 50, 68, 0);\n  text(\"B\", 106, 68, 0);\n  if (flash === 0 || every(4)) text(label, 52, 108, 2);\n}\n",
  "author": "tynt",
  "description": "Compare single tones with a short synthesized sequence.",
  "controls": "A plays 440 Hz · B plays an arpeggio",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
