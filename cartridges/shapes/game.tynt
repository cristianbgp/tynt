  "title": "shapes",
  "source": "export function init(): void {\n  clear(0);\n}\n\nexport function update(): void {}\n\nexport function draw(): void {\n  clear(0);\n\n  pixel(18, 24, 3);\n  line(28, 24, 66, 24, 2);\n  rect(18, 42, 42, 24, 3, false);\n  rect(70, 42, 42, 24, 2, true);\n  triangle(120, 42, 150, 54, 120, 66, 3, true);\n  circle(42, 100, 18, 1, false);\n  circle(102, 100, 18, 3, true);\n\n  text(\"PIXEL + LINE\", 18, 14, 3);\n  text(\"RECT\", 18, 72, 2);\n  text(\"TRI\", 126, 72, 2);\n  text(\"CIRCLE\", 78, 128, 3);\n}\n",
