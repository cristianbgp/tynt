{
  "format": "tynt",
  "version": 1,
  "title": "platformer",
  "author": "tynt",
  "description": "Jump through a compact level and collect every coin.",
  "controls": "Left/right move · A jumps · B resets",
  "source": "type Platform = { x: number; y: number; width: number };\ntype Coin = { x: number; y: number; found: boolean };\n\nconst platforms: Platform[] = [\n  { x: 0, y: 136, width: 160 },\n  { x: 18, y: 108, width: 42 },\n  { x: 82, y: 88, width: 48 },\n  { x: 34, y: 61, width: 34 },\n  { x: 106, y: 38, width: 42 },\n];\nlet coins: Coin[] = [];\nlet x = 18;\nlet y = 96;\nlet velocityY = 0;\nlet grounded = false;\nlet won = false;\n\nfunction reset(): void {\n  x = 18;\n  y = 96;\n  velocityY = 0;\n  grounded = false;\n  won = false;\n  coins = [\n    { x: 48, y: 99, found: false },\n    { x: 116, y: 79, found: false },\n    { x: 56, y: 52, found: false },\n    { x: 130, y: 29, found: false },\n  ];\n}\n\nexport function init(): void {\n  reset();\n}\n\nexport function update(): void {\n  if (won) {\n    if (buttonPressed(\"a\") || buttonPressed(\"b\")) reset();\n    return;\n  }\n  if (button(\"left\")) x -= 1;\n  if (button(\"right\")) x += 1;\n  x = Math.max(0, Math.min(153, x));\n\n  if (buttonPressed(\"a\") && grounded) {\n    velocityY = -4.1;\n    grounded = false;\n    tone(360, 45, 0.06);\n  }\n  if (buttonPressed(\"b\")) reset();\n\n  const previousBottom = y + 8;\n  velocityY += 0.22;\n  y += velocityY;\n  grounded = false;\n  if (velocityY >= 0) {\n    for (const platform of platforms) {\n      const nextBottom = y + 8;\n      if (overlap(x, y, 7, 8, platform.x, platform.y, platform.width, 3) && previousBottom <= platform.y && nextBottom >= platform.y) {\n        y = platform.y - 8;\n        velocityY = 0;\n        grounded = true;\n      }\n    }\n  }\n\n  for (const coin of coins) {\n    if (!coin.found && overlap(x, y, 7, 8, coin.x, coin.y, 5, 5)) {\n      coin.found = true;\n      tone(620 + coins.filter((item) => item.found).length * 60, 65, 0.09);\n    }\n  }\n  if (coins.every((coin) => coin.found)) {\n    won = true;\n    sfx([440, 550, 660, 880], 60, 0.1);\n  }\n  if (y > 150) reset();\n}\n\nexport function draw(): void {\n  clear(0);\n  const found = coins.filter((coin) => coin.found).length;\n  text(\"PLATFORM\", 7, 7, 3);\n  text(\"COINS \" + found + \"/4\", 101, 7, 2);\n  for (const platform of platforms) rect(platform.x, platform.y, platform.width, 3, 2, true);\n  for (const coin of coins) if (!coin.found) circle(coin.x + 2, coin.y + 2, 2, every(10) ? 3 : 2, true);\n  rect(x, y, 7, 8, grounded ? 3 : 2, true);\n  pixel(x + 5, y + 2, 0);\n  if (won) {\n    rect(39, 59, 82, 26, 0, true);\n    rect(39, 59, 82, 26, 3, false);\n    text(\"ALL FOUND\", 55, 65, 3);\n    text(\"A/B AGAIN\", 57, 75, 2);\n  }\n}\n",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
