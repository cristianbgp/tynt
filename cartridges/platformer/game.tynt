{
  "format": "tynt",
  "version": 1,
  "title": "platformer",
  "source": "type Platform = { x: number; y: number; width: number };\n\nconst platforms: Platform[] = [\n  { x: 0, y: 136, width: 160 },\n  { x: 18, y: 108, width: 42 },\n  { x: 82, y: 88, width: 48 },\n  { x: 34, y: 61, width: 34 },\n  { x: 106, y: 38, width: 42 },\n];\n\nlet x = 18;\nlet y = 96;\nlet velocityY = 0;\nlet grounded = false;\nlet height = 0;\n\nfunction reset(): void {\n  x = 18;\n  y = 96;\n  velocityY = 0;\n  grounded = false;\n  height = 0;\n}\n\nexport function init(): void {\n  reset();\n}\n\nexport function update(): void {\n  if (button(\"left\")) x -= 1;\n  if (button(\"right\")) x += 1;\n  x = Math.max(0, Math.min(153, x));\n\n  if (buttonPressed(\"a\") && grounded) {\n    velocityY = -4.1;\n    grounded = false;\n  }\n  if (buttonPressed(\"b\")) reset();\n\n  const previousBottom = y + 8;\n  velocityY += 0.22;\n  y += velocityY;\n  grounded = false;\n\n  if (velocityY >= 0) {\n    for (const platform of platforms) {\n      const nextBottom = y + 8;\n      const overlapsX = x + 7 > platform.x && x < platform.x + platform.width;\n      if (overlapsX && previousBottom <= platform.y && nextBottom >= platform.y) {\n        y = platform.y - 8;\n        velocityY = 0;\n        grounded = true;\n      }\n    }\n  }\n\n  height = Math.max(height, 136 - Math.round(y));\n  if (y > 150) reset();\n}\n\nexport function draw(): void {\n  clear(0);\n  text(\"PLATFORM\", 7, 7, 3);\n  text(\"HEIGHT \" + height, 91, 7, 2);\n  for (const platform of platforms) rect(platform.x, platform.y, platform.width, 3, 2, true);\n  rect(x, y, 7, 8, grounded ? 3 : 2, true);\n  pixel(x + 5, y + 2, 0);\n}\n",
  "author": "tynt",
  "description": "Explore gravity, jumping, landing, and level geometry.",
  "controls": "Left/right move · A jumps · B resets",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
