{
  "format": "tynt",
  "version": 1,
  "title": "animation",
  "source": "let x = 16;\n\nexport function init(): void {\n  clear(0);\n}\n\nexport function update(): void {\n  x = wrap(x + 1, -8, 168);\n}\n\nexport function draw(): void {\n  clear(0);\n  line(0, 82, 159, 82, 1);\n  circle(x, 72, 8, 3, true);\n  text(\"60 FPS LOOP\", 56, 102, 2);\n}\n",
  "author": "tynt",
  "description": "Learn fixed-step movement with a looping marker.",
  "controls": "No input · automatic animation",
  "canvas": {
    "width": 160,
    "height": 144
  },
