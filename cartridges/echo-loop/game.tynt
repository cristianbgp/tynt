{
  "format": "tynt",
  "version": 1,
  "title": "echo loop",
  "author": "cristianbgp",
  "description": "A precision platformer where every failed run returns as an echo.",
  "controls": "Left/right move · A jumps and wall-jumps · B records the current loop",
  "source": "type Box = { x: number; y: number; width: number; height: number };\ntype Point = { x: number; y: number };\ntype Particle = { x: number; y: number; vx: number; vy: number; life: number };\ntype Level = {\n  name: string;\n  spawnX: number;\n  spawnY: number;\n  exit: Box;\n  solids: Box[];\n  spikes: Box[];\n  switches: Box[];\n};\n\nconst PLAYER_WIDTH = 6;\nconst PLAYER_HEIGHT = 8;\nconst MAX_ECHOES = 3;\nconst ground: Box = { x: 0, y: 132, width: 160, height: 12 };\nconst levels: Level[] = [\n  {\n    name: \"FIRST STEPS\",\n    spawnX: 8,\n    spawnY: 124,\n    exit: { x: 146, y: 116, width: 8, height: 16 },\n    solids: [ground, { x: 54, y: 112, width: 28, height: 4 }, { x: 100, y: 94, width: 28, height: 4 }],\n    spikes: [],\n    switches: [],\n  },\n  {\n    name: \"MIND THE GAP\",\n    spawnX: 8,\n    spawnY: 124,\n    exit: { x: 146, y: 116, width: 8, height: 16 },\n    solids: [ground, { x: 63, y: 108, width: 34, height: 4 }],\n    spikes: [{ x: 36, y: 126, width: 20, height: 6 }, { x: 106, y: 126, width: 24, height: 6 }],\n    switches: [],\n  },\n  {\n    name: \"WALL WORK\",\n    spawnX: 8,\n    spawnY: 124,\n    exit: { x: 141, y: 40, width: 8, height: 16 },\n    solids: [\n      ground,\n      { x: 42, y: 82, width: 5, height: 50 },\n      { x: 77, y: 58, width: 5, height: 74 },\n      { x: 112, y: 34, width: 5, height: 98 },\n      { x: 112, y: 56, width: 48, height: 4 },\n    ],\n    spikes: [],\n    switches: [],\n  },\n  {\n    name: \"MEET YOURSELF\",\n    spawnX: 8,\n    spawnY: 124,\n    exit: { x: 146, y: 116, width: 8, height: 16 },\n    solids: [ground, { x: 46, y: 106, width: 26, height: 4 }, { x: 92, y: 84, width: 28, height: 4 }],\n    spikes: [{ x: 30, y: 126, width: 12, height: 6 }, { x: 76, y: 126, width: 12, height: 6 }, { x: 124, y: 126, width: 12, height: 6 }],\n    switches: [],\n  },\n  {\n    name: \"HOLD THE LINE\",\n    spawnX: 8,\n    spawnY: 124,\n    exit: { x: 146, y: 116, width: 8, height: 16 },\n    solids: [ground, { x: 72, y: 108, width: 24, height: 4 }],\n    spikes: [{ x: 104, y: 126, width: 18, height: 6 }],\n    switches: [{ x: 27, y: 128, width: 12, height: 4 }],\n  },\n  {\n    name: \"TWO OF YOU\",\n    spawnX: 74,\n    spawnY: 124,\n    exit: { x: 76, y: 92, width: 8, height: 16 },\n    solids: [ground, { x: 44, y: 108, width: 72, height: 4 }],\n    spikes: [],\n    switches: [{ x: 38, y: 128, width: 12, height: 4 }],\n  },\n  {\n    name: \"THREE TRACES\",\n    spawnX: 77,\n    spawnY: 124,\n    exit: { x: 76, y: 84, width: 8, height: 16 },\n    solids: [ground, { x: 48, y: 100, width: 64, height: 4 }],\n    spikes: [],\n    switches: [{ x: 28, y: 128, width: 12, height: 4 }, { x: 120, y: 128, width: 12, height: 4 }],\n  },\n  {\n    name: \"BREAK THE LOOP\",\n    spawnX: 8,\n    spawnY: 124,\n    exit: { x: 142, y: 48, width: 8, height: 16 },\n    solids: [\n      ground,\n      { x: 32, y: 112, width: 36, height: 4 },\n      { x: 72, y: 88, width: 36, height: 4 },\n      { x: 112, y: 64, width: 48, height: 4 },\n    ],\n    spikes: [],\n    switches: [{ x: 28, y: 128, width: 12, height: 4 }, { x: 128, y: 128, width: 12, height: 4 }],\n  },\n];\n\nlet levelIndex = 0;\nlet x = 0;\nlet y = 0;\nlet velocityX = 0;\nlet velocityY = 0;\nlet grounded = false;\nlet wallLeft = false;\nlet wallRight = false;\nlet attemptTick = 0;\nlet attempts = 0;\nlet startedAt = 0;\nlet banner = 0;\nlet shake = 0;\nlet won = false;\nlet trail: Point[] = [];\nlet echoes: Point[][] = [];\nlet movedFromSpawn = false;\nlet echoesActive = false;\nlet echoTick = 0;\nlet particles: Particle[] = [];\n\nfunction level(): Level {\n  return levels[levelIndex];\n}\n\nfunction resetPlayer(): void {\n  const current = level();\n  x = current.spawnX;\n  y = current.spawnY;\n  velocityX = 0;\n  velocityY = 0;\n  grounded = false;\n  wallLeft = false;\n  wallRight = false;\n  attemptTick = 0;\n  echoTick = 0;\n  movedFromSpawn = false;\n  echoesActive = false;\n  trail = [];\n}\n\nfunction startLevel(index: number): void {\n  levelIndex = index;\n  echoes = [];\n  banner = 75;\n  resetPlayer();\n}\n\nfunction echoPoint(path: Point[]): Point {\n  return path[Math.min(echoTick, path.length - 1)];\n}\n\nfunction outsideSpawn(point: Point): boolean {\n  const current = level();\n  return (\n    Math.abs(point.x - current.spawnX) >= PLAYER_WIDTH ||\n    Math.abs(point.y - current.spawnY) >= PLAYER_HEIGHT\n  );\n}\n\nfunction updateEchoActivation(): void {\n  if (!movedFromSpawn && outsideSpawn({ x, y })) {\n    movedFromSpawn = true;\n    echoesActive = echoes.length > 0;\n  }\n  if (echoesActive) echoTick++;\n}\n\nfunction burst(): void {\n  const directions = [\n    [-1.4, -1.8],\n    [-0.6, -2.3],\n    [0.6, -2.3],\n    [1.4, -1.8],\n    [-1.2, -0.6],\n    [1.2, -0.6],\n  ];\n  for (const direction of directions) {\n    particles.push({ x: x + 3, y: y + 4, vx: direction[0], vy: direction[1], life: 18 });\n  }\n}\n\nfunction loopAttempt(died: boolean): void {\n  const echoStart = trail.findIndex((point) => outsideSpawn(point));\n  const echoPath = echoStart < 0 ? [] : trail.slice(echoStart);\n  const recordsEcho = echoPath.length > 6;\n  if (recordsEcho) {\n    echoes.push(echoPath);\n    if (echoes.length > MAX_ECHOES) echoes.shift();\n  }\n  if (died || recordsEcho) attempts++;\n  if (died) {\n    burst();\n    shake = 7;\n    sfx([180, 120, 80], 35, 0.08, \"sawtooth\");\n  } else {\n    tone(260, 35, 0.07, \"square\");\n  }\n  resetPlayer();\n}\n\nfunction updateParticles(): void {\n  for (const particle of particles) {\n    particle.x += particle.vx;\n    particle.y += particle.vy;\n    particle.vy += 0.14;\n    particle.life--;\n  }\n  particles = particles.filter((particle) => particle.life > 0);\n}\n\nfunction movePlayer(): void {\n  const current = level();\n  const movingLeft = button(\"left\");\n  const movingRight = button(\"right\");\n  if (movingLeft) velocityX -= 0.42;\n  if (movingRight) velocityX += 0.42;\n  if (!movingLeft && !movingRight) velocityX *= 0.72;\n  velocityX = clamp(velocityX, -2.4, 2.4);\n\n  if (buttonPressed(\"a\")) {\n    if (grounded) {\n      velocityY = -4.35;\n      tone(420, 32, 0.05, \"square\");\n    } else if (wallLeft) {\n      velocityX = 2.8;\n      velocityY = -4.1;\n      tone(500, 30, 0.05, \"square\");\n    } else if (wallRight) {\n      velocityX = -2.8;\n      velocityY = -4.1;\n      tone(500, 30, 0.05, \"square\");\n    }\n  }\n  if (buttonReleased(\"a\") && velocityY < -1.7) velocityY = -1.7;\n\n  wallLeft = false;\n  wallRight = false;\n  x += velocityX;\n  if (x < 0) {\n    x = 0;\n    velocityX = 0;\n    wallLeft = true;\n  }\n  if (x > 160 - PLAYER_WIDTH) {\n    x = 160 - PLAYER_WIDTH;\n    velocityX = 0;\n    wallRight = true;\n  }\n  for (const solid of current.solids) {\n    if (!overlap(x, y, PLAYER_WIDTH, PLAYER_HEIGHT, solid.x, solid.y, solid.width, solid.height)) continue;\n    if (velocityX > 0) {\n      x = solid.x - PLAYER_WIDTH;\n      wallRight = true;\n    } else if (velocityX < 0) {\n      x = solid.x + solid.width;\n      wallLeft = true;\n    }\n    velocityX = 0;\n  }\n\n  const previousBottom = y + PLAYER_HEIGHT;\n  velocityY = Math.min(velocityY + 0.24, 5.2);\n  y += velocityY;\n  grounded = false;\n  for (const solid of current.solids) {\n    if (!overlap(x, y, PLAYER_WIDTH, PLAYER_HEIGHT, solid.x, solid.y, solid.width, solid.height)) continue;\n    if (velocityY >= 0 && previousBottom <= solid.y + 1) {\n      y = solid.y - PLAYER_HEIGHT;\n      velocityY = 0;\n      grounded = true;\n    } else if (velocityY < 0) {\n      y = solid.y + solid.height;\n      velocityY = 0;\n    }\n  }\n}\n\nfunction switchIsPressed(target: Box): boolean {\n  if (overlap(x, y, PLAYER_WIDTH, PLAYER_HEIGHT, target.x, target.y - 2, target.width, target.height + 2)) return true;\n  if (echoesActive) {\n    for (const path of echoes) {\n      const point = echoPoint(path);\n      if (overlap(point.x, point.y, PLAYER_WIDTH, PLAYER_HEIGHT, target.x, target.y - 2, target.width, target.height + 2)) return true;\n    }\n  }\n  return false;\n}\n\nfunction doorIsOpen(): boolean {\n  return level().switches.every((target) => switchIsPressed(target));\n}\n\nfunction touchesDanger(): boolean {\n  const current = level();\n  if (y > 144) return true;\n  if (current.spikes.some((spike) => overlap(x, y, PLAYER_WIDTH, PLAYER_HEIGHT, spike.x, spike.y, spike.width, spike.height))) return true;\n  if (!echoesActive || echoTick < 22) return false;\n  for (const path of echoes) {\n    const point = echoPoint(path);\n    if (overlap(x, y, PLAYER_WIDTH, PLAYER_HEIGHT, point.x, point.y, PLAYER_WIDTH, PLAYER_HEIGHT)) return true;\n  }\n  return false;\n}\n\nfunction advanceLevel(): void {\n  sfx([440, 590, 740, 920], 42, 0.08, \"triangle\");\n  if (levelIndex === levels.length - 1) {\n    won = true;\n    return;\n  }\n  startLevel(levelIndex + 1);\n}\n\nexport function init(): void {\n  startedAt = frame();\n  attempts = 0;\n  won = false;\n  particles = [];\n  startLevel(0);\n}\n\nexport function update(): void {\n  updateParticles();\n  if (shake > 0) shake--;\n  if (banner > 0) banner--;\n  if (won) {\n    if (buttonPressed(\"a\") || buttonPressed(\"b\")) init();\n    return;\n  }\n  if (buttonPressed(\"b\")) {\n    loopAttempt(false);\n    return;\n  }\n\n  movePlayer();\n  trail.push({ x, y });\n  attemptTick++;\n  updateEchoActivation();\n\n  if (touchesDanger()) {\n    loopAttempt(true);\n    return;\n  }\n  const exit = level().exit;\n  if (doorIsOpen() && overlap(x, y, PLAYER_WIDTH, PLAYER_HEIGHT, exit.x, exit.y, exit.width, exit.height)) {\n    advanceLevel();\n  }\n}\n\nfunction drawSpike(spike: Box): void {\n  const count = Math.max(1, Math.floor(spike.width / 6));\n  for (let index = 0; index < count; index++) {\n    const left = spike.x + index * 6;\n    triangle(left, spike.y + spike.height, left + 3, spike.y, left + 6, spike.y + spike.height, 3, true);\n  }\n}\n\nfunction drawWorld(): void {\n  const current = level();\n  for (const solid of current.solids) rect(solid.x, solid.y, solid.width, solid.height, 2, true);\n  for (const spike of current.spikes) drawSpike(spike);\n\n  for (const target of current.switches) {\n    const pressed = switchIsPressed(target);\n    rect(target.x, target.y, target.width, target.height, pressed ? 3 : 1, true);\n  }\n\n  const open = doorIsOpen();\n  rect(current.exit.x, current.exit.y, current.exit.width, current.exit.height, open ? 3 : 1, false);\n  if (!open) {\n    line(current.exit.x, current.exit.y, current.exit.x + current.exit.width - 1, current.exit.y + current.exit.height - 1, 1);\n    line(current.exit.x + current.exit.width - 1, current.exit.y, current.exit.x, current.exit.y + current.exit.height - 1, 1);\n  }\n\n  if (echoesActive) {\n    for (let index = 0; index < echoes.length; index++) {\n      const point = echoPoint(echoes[index]);\n      const shade = index === echoes.length - 1 ? 2 : 1;\n      rect(point.x, point.y, PLAYER_WIDTH, PLAYER_HEIGHT, shade, false);\n      pixel(point.x + 2, point.y + 2, shade);\n    }\n  }\n\n  rect(x, y, PLAYER_WIDTH, PLAYER_HEIGHT, 3, true);\n  pixel(x + (velocityX < 0 ? 1 : 4), y + 2, 0);\n  for (const particle of particles) pixel(particle.x, particle.y, particle.life > 8 ? 3 : 2);\n}\n\nexport function draw(): void {\n  clear(0);\n  if (won) {\n    text(\"ECHO LOOP\", 62, 39, 3);\n    text(\"LOOP BROKEN\", 58, 58, every(12) ? 3 : 2);\n    text(\"DEATHS \" + attempts, 62, 75, 2);\n    text(\"TIME \" + Math.floor((frame() - startedAt) / 60) + \"S\", 66, 87, 1);\n    text(\"A/B AGAIN\", 62, 106, 3);\n    return;\n  }\n\n  const offset = shake > 0 ? (shake % 2 === 0 ? -2 : 2) : 0;\n  camera(offset, 0);\n  drawWorld();\n  camera();\n\n  rect(0, 0, 160, 13, 0, true);\n  text(\"ECHO LOOP\", 4, 4, 3);\n  text(String(levelIndex + 1) + \"/\" + levels.length, 73, 4, 2);\n  text(\"X\" + (echoesActive ? echoes.length : 0), 101, 4, 1);\n  text(\"D\" + attempts, 133, 4, 2);\n\n  if (banner > 0) {\n    const label = level().name;\n    rect(23, 61, 114, 22, 0, true);\n    rect(23, 61, 114, 22, 3, false);\n    text(label, 80 - label.length * 2, 69, 3);\n  }\n}\n",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
