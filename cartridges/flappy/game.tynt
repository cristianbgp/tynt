{
  "format": "tynt",
  "version": 1,
  "title": "flappy",
  "author": "tynt",
  "description": "Fly through seeded, changing pipe gaps and chase a higher score.",
  "controls": "A flaps · B resets · A or B retries",
  "source": "type Pipe = { x: number; gap: number; scored: boolean };\n\nlet birdY = 68;\nlet velocity = 0;\nlet pipes: Pipe[] = [];\nlet score = 0;\nlet over = false;\n\nfunction nextGap(): number {\n  return Math.floor(random(48, 101));\n}\n\nfunction reset(): void {\n  seed(2048);\n  birdY = 68;\n  velocity = 0;\n  pipes = [\n    { x: 126, gap: nextGap(), scored: false },\n    { x: 206, gap: nextGap(), scored: false },\n  ];\n  score = 0;\n  over = false;\n}\n\nfunction crash(): void {\n  if (over) return;\n  over = true;\n  sfx([240, 150, 80], 65, 0.09, \"triangle\");\n}\n\nexport function init(): void {\n  reset();\n}\n\nexport function update(): void {\n  if (over) {\n    if (buttonPressed(\"a\") || buttonPressed(\"b\")) reset();\n    return;\n  }\n  if (buttonPressed(\"a\")) {\n    velocity = -3.2;\n    tone(520, 30, 0.05);\n  }\n  if (buttonPressed(\"b\")) reset();\n\n  velocity += 0.18;\n  birdY += velocity;\n\n  for (const pipe of pipes) {\n    pipe.x -= 1;\n    if (!pipe.scored && pipe.x + 14 < 36) {\n      pipe.scored = true;\n      score++;\n      tone(760, 55, 0.08);\n    }\n    const hitsTop = overlap(36, birdY - 4, 8, 8, pipe.x, 18, 14, pipe.gap - 36);\n    const hitsBottom = overlap(36, birdY - 4, 8, 8, pipe.x, pipe.gap + 18, 14, 121 - pipe.gap);\n    if (hitsTop || hitsBottom) crash();\n  }\n\n  if (pipes[0]!.x < -16) {\n    const pipe = pipes.shift()!;\n    const last = pipes[pipes.length - 1]!;\n    pipe.x = last.x + 80;\n    pipe.gap = nextGap();\n    pipe.scored = false;\n    pipes.push(pipe);\n  }\n  if (birdY < 20 || birdY > 135) crash();\n}\n\nexport function draw(): void {\n  clear(0);\n  text(\"FLAPPY\", 7, 7, 3);\n  text(\"SCORE \" + score, 100, 7, 2);\n  line(0, 139, 159, 139, 1);\n  for (const pipe of pipes) {\n    rect(pipe.x, 18, 14, pipe.gap - 36, 2, true);\n    rect(pipe.x, pipe.gap + 18, 14, 121 - pipe.gap, 2, true);\n  }\n  circle(40, birdY, 4, 3, true);\n  pixel(42, birdY - 1, 0);\n  if (over) {\n    rect(35, 61, 90, 24, 0, true);\n    rect(35, 61, 90, 24, 3, false);\n    text(\"GAME OVER\", 49, 66, 3);\n    text(\"A/B RETRY\", 47, 76, 2);\n  }\n}\n",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
