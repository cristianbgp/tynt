{
  "format": "tynt",
  "version": 1,
  "title": "snake",
  "author": "tynt",
  "description": "Eat procedurally placed food, grow, and avoid the walls and yourself.",
  "controls": "Arrows steer · A or B restarts",
  "source": "type Point = { x: number; y: number };\n\nlet segments: Point[] = [];\nlet direction = { x: 1, y: 0 };\nlet food = { x: 14, y: 6 };\nlet score = 0;\nlet over = false;\n\nfunction placeFood(): void {\n  for (let attempt = 0; attempt < 40; attempt++) {\n    const candidate = { x: Math.floor(random(1, 19)), y: Math.floor(random(3, 17)) };\n    if (!segments.some((segment) => segment.x === candidate.x && segment.y === candidate.y)) {\n      food = candidate;\n      return;\n    }\n  }\n}\n\nfunction finish(): void {\n  over = true;\n  sfx([220, 160, 100], 70, 0.09, \"triangle\");\n}\n\nfunction reset(): void {\n  seed(1977);\n  segments = [{ x: 8, y: 9 }, { x: 7, y: 9 }, { x: 6, y: 9 }];\n  direction = { x: 1, y: 0 };\n  score = 0;\n  over = false;\n  placeFood();\n}\n\nexport function init(): void {\n  reset();\n}\n\nexport function update(): void {\n  if (over) {\n    if (buttonPressed(\"a\") || buttonPressed(\"b\")) reset();\n    return;\n  }\n\n  if (buttonPressed(\"left\") && direction.x !== 1) direction = { x: -1, y: 0 };\n  if (buttonPressed(\"right\") && direction.x !== -1) direction = { x: 1, y: 0 };\n  if (buttonPressed(\"up\") && direction.y !== 1) direction = { x: 0, y: -1 };\n  if (buttonPressed(\"down\") && direction.y !== -1) direction = { x: 0, y: 1 };\n  if (!every(7)) return;\n\n  const head = segments[0]!;\n  const next = { x: head.x + direction.x, y: head.y + direction.y };\n  if (!pointInRect(next.x, next.y, 1, 3, 18, 14)) {\n    finish();\n    return;\n  }\n  if (segments.some((segment) => segment.x === next.x && segment.y === next.y)) {\n    finish();\n    return;\n  }\n\n  segments.unshift(next);\n  if (next.x === food.x && next.y === food.y) {\n    score++;\n    tone(420 + score * 35, 55, 0.09);\n    placeFood();\n  } else {\n    segments.pop();\n  }\n}\n\nexport function draw(): void {\n  clear(0);\n  text(\"SNAKE\", 8, 7, 3);\n  text(\"SCORE \" + score, 96, 7, 2);\n  rect(7, 19, 146, 118, 1, false);\n  rect(food.x * 8 + 1, food.y * 8 + 1, 6, 6, every(10) ? 3 : 2, true);\n  for (let index = 0; index < segments.length; index++) {\n    const segment = segments[index]!;\n    rect(segment.x * 8 + 1, segment.y * 8 + 1, 6, 6, index === 0 ? 3 : 2, true);\n  }\n  if (over) {\n    rect(35, 61, 90, 24, 0, true);\n    rect(35, 61, 90, 24, 3, false);\n    text(\"GAME OVER\", 49, 66, 3);\n    text(\"A/B RETRY\", 47, 76, 2);\n  }\n}\n",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
