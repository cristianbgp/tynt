{
  "format": "tynt",
  "version": 1,
  "title": "asteroids",
  "source": "type Body = { x: number; y: number; vx: number; vy: number };\ntype Rock = Body & { radius: number };\n\nlet ship = { x: 80, y: 76, vx: 0, vy: 0, angle: -Math.PI / 2 };\nlet bullets: Body[] = [];\nlet rocks: Rock[] = [];\nlet cooldown = 0;\nlet score = 0;\n\nfunction wrap(value: number, limit: number): number {\n  if (value < 0) return value + limit;\n  if (value >= limit) return value - limit;\n  return value;\n}\n\nfunction reset(): void {\n  ship = { x: 80, y: 76, vx: 0, vy: 0, angle: -Math.PI / 2 };\n  bullets = [];\n  rocks = [\n    { x: 24, y: 34, vx: 0.18, vy: 0.09, radius: 8 },\n    { x: 132, y: 48, vx: -0.14, vy: 0.12, radius: 6 },\n    { x: 112, y: 118, vx: -0.1, vy: -0.16, radius: 10 },\n  ];\n  score = 0;\n}\n\nexport function init(): void {\n  reset();\n}\n\nexport function update(): void {\n  if (button(\"left\")) ship.angle -= 0.055;\n  if (button(\"right\")) ship.angle += 0.055;\n  if (button(\"up\")) {\n    ship.vx += Math.cos(ship.angle) * 0.035;\n    ship.vy += Math.sin(ship.angle) * 0.035;\n  }\n  ship.vx *= 0.995;\n  ship.vy *= 0.995;\n  ship.x = wrap(ship.x + ship.vx, 160);\n  ship.y = wrap(ship.y + ship.vy, 144);\n\n  if (cooldown > 0) cooldown--;\n  if (buttonPressed(\"a\") && cooldown === 0) {\n    bullets.push({\n      x: ship.x,\n      y: ship.y,\n      vx: Math.cos(ship.angle) * 2.2,\n      vy: Math.sin(ship.angle) * 2.2,\n    });\n    cooldown = 8;\n  }\n  if (buttonPressed(\"b\")) reset();\n\n  for (const bullet of bullets) {\n    bullet.x = wrap(bullet.x + bullet.vx, 160);\n    bullet.y = wrap(bullet.y + bullet.vy, 144);\n  }\n  for (const rock of rocks) {\n    rock.x = wrap(rock.x + rock.vx, 160);\n    rock.y = wrap(rock.y + rock.vy, 144);\n  }\n\n  for (let bulletIndex = bullets.length - 1; bulletIndex >= 0; bulletIndex--) {\n    const bullet = bullets[bulletIndex]!;\n    for (let rockIndex = rocks.length - 1; rockIndex >= 0; rockIndex--) {\n      const rock = rocks[rockIndex]!;\n      const dx = bullet.x - rock.x;\n      const dy = bullet.y - rock.y;\n      if (dx * dx + dy * dy <= rock.radius * rock.radius) {\n        bullets.splice(bulletIndex, 1);\n        rocks.splice(rockIndex, 1);\n        score++;\n        break;\n      }\n    }\n  }\n  if (rocks.length === 0) reset();\n}\n\nexport function draw(): void {\n  clear(0);\n  text(\"ASTEROIDS\", 7, 7, 3);\n  text(\"SCORE \" + score, 102, 7, 2);\n\n  const noseX = ship.x + Math.cos(ship.angle) * 8;\n  const noseY = ship.y + Math.sin(ship.angle) * 8;\n  const leftX = ship.x + Math.cos(ship.angle + 2.45) * 7;\n  const leftY = ship.y + Math.sin(ship.angle + 2.45) * 7;\n  const rightX = ship.x + Math.cos(ship.angle - 2.45) * 7;\n  const rightY = ship.y + Math.sin(ship.angle - 2.45) * 7;\n  line(noseX, noseY, leftX, leftY, 3);\n  line(leftX, leftY, rightX, rightY, 3);\n  line(rightX, rightY, noseX, noseY, 3);\n\n  for (const bullet of bullets) pixel(bullet.x, bullet.y, 3);\n  for (const rock of rocks) circle(rock.x, rock.y, rock.radius, 2, false);\n}\n",
  "author": "tynt",
  "description": "Combine rotation, velocity, projectiles, and collisions.",
  "controls": "Left/right rotate · Up thrusts · A fires · B resets",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
