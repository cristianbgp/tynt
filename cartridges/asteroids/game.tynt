{
  "format": "tynt",
  "version": 1,
  "title": "asteroids",
  "author": "tynt",
  "description": "Clear a seeded asteroid field while managing momentum, shots, and collisions.",
  "controls": "Left/right rotate · Up thrusts · A fires · B resets",
  "source": "type Body = { x: number; y: number; vx: number; vy: number };\ntype Bullet = Body & { life: number };\ntype Rock = Body & { radius: number };\n\nlet ship = { x: 80, y: 76, vx: 0, vy: 0, angle: -Math.PI / 2 };\nlet bullets: Bullet[] = [];\nlet rocks: Rock[] = [];\nlet cooldown = 0;\nlet score = 0;\nlet state = \"playing\";\n\nfunction wrap(value: number, limit: number): number {\n  if (value < 0) return value + limit;\n  if (value >= limit) return value - limit;\n  return value;\n}\n\nfunction createRocks(): Rock[] {\n  const result: Rock[] = [];\n  for (let index = 0; index < 4; index++) {\n    const angle = random(0, Math.PI * 2);\n    const speed = random(0.08, 0.22);\n    result.push({\n      x: index < 2 ? random(12, 52) : random(108, 148),\n      y: random(28, 132),\n      vx: Math.cos(angle) * speed,\n      vy: Math.sin(angle) * speed,\n      radius: Math.floor(random(6, 11)),\n    });\n  }\n  return result;\n}\n\nfunction reset(): void {\n  seed(1979);\n  ship = { x: 80, y: 76, vx: 0, vy: 0, angle: -Math.PI / 2 };\n  bullets = [];\n  rocks = createRocks();\n  cooldown = 0;\n  score = 0;\n  state = \"playing\";\n}\n\nexport function init(): void {\n  reset();\n}\n\nexport function update(): void {\n  if (state !== \"playing\") {\n    if (buttonPressed(\"a\") || buttonPressed(\"b\")) reset();\n    return;\n  }\n  if (button(\"left\")) ship.angle -= 0.055;\n  if (button(\"right\")) ship.angle += 0.055;\n  if (button(\"up\")) {\n    ship.vx += Math.cos(ship.angle) * 0.035;\n    ship.vy += Math.sin(ship.angle) * 0.035;\n  }\n  ship.vx *= 0.995;\n  ship.vy *= 0.995;\n  ship.x = wrap(ship.x + ship.vx, 160);\n  ship.y = wrap(ship.y + ship.vy, 144);\n\n  if (cooldown > 0) cooldown--;\n  if (buttonPressed(\"a\") && cooldown === 0) {\n    bullets.push({ x: ship.x, y: ship.y, vx: Math.cos(ship.angle) * 2.2, vy: Math.sin(ship.angle) * 2.2, life: 75 });\n    cooldown = 8;\n    tone(540, 28, 0.05);\n  }\n  if (buttonPressed(\"b\")) reset();\n\n  for (const bullet of bullets) {\n    bullet.x = wrap(bullet.x + bullet.vx, 160);\n    bullet.y = wrap(bullet.y + bullet.vy, 144);\n    bullet.life--;\n  }\n  bullets = bullets.filter((bullet) => bullet.life > 0);\n  for (const rock of rocks) {\n    rock.x = wrap(rock.x + rock.vx, 160);\n    rock.y = wrap(rock.y + rock.vy, 144);\n    const dx = ship.x - rock.x;\n    const dy = ship.y - rock.y;\n    if (dx * dx + dy * dy < (rock.radius + 4) * (rock.radius + 4)) {\n      state = \"crashed\";\n      sfx([240, 150, 80], 70, 0.1, \"sawtooth\");\n    }\n  }\n\n  for (let bulletIndex = bullets.length - 1; bulletIndex >= 0; bulletIndex--) {\n    const bullet = bullets[bulletIndex]!;\n    for (let rockIndex = rocks.length - 1; rockIndex >= 0; rockIndex--) {\n      const rock = rocks[rockIndex]!;\n      const dx = bullet.x - rock.x;\n      const dy = bullet.y - rock.y;\n      if (dx * dx + dy * dy <= rock.radius * rock.radius) {\n        bullets.splice(bulletIndex, 1);\n        rocks.splice(rockIndex, 1);\n        score++;\n        tone(260 + score * 45, 45, 0.08);\n        break;\n      }\n    }\n  }\n  if (rocks.length === 0) {\n    state = \"cleared\";\n    sfx([330, 440, 660, 880], 65, 0.1);\n  }\n}\n\nexport function draw(): void {\n  clear(0);\n  text(\"ASTEROIDS\", 7, 7, 3);\n  text(\"SCORE \" + score, 102, 7, 2);\n  const noseX = ship.x + Math.cos(ship.angle) * 8;\n  const noseY = ship.y + Math.sin(ship.angle) * 8;\n  const leftX = ship.x + Math.cos(ship.angle + 2.45) * 7;\n  const leftY = ship.y + Math.sin(ship.angle + 2.45) * 7;\n  const rightX = ship.x + Math.cos(ship.angle - 2.45) * 7;\n  const rightY = ship.y + Math.sin(ship.angle - 2.45) * 7;\n  line(noseX, noseY, leftX, leftY, 3);\n  line(leftX, leftY, rightX, rightY, 3);\n  line(rightX, rightY, noseX, noseY, 3);\n  if (button(\"up\") && every(3)) line(ship.x, ship.y, ship.x - Math.cos(ship.angle) * 7, ship.y - Math.sin(ship.angle) * 7, 2);\n  for (const bullet of bullets) pixel(bullet.x, bullet.y, 3);\n  for (const rock of rocks) circle(rock.x, rock.y, rock.radius, 2, false);\n  if (state !== \"playing\") {\n    rect(38, 60, 84, 26, 0, true);\n    rect(38, 60, 84, 26, state === \"cleared\" ? 3 : 2, false);\n    text(state === \"cleared\" ? \"SECTOR CLEAR\" : \"SHIP LOST\", state === \"cleared\" ? 45 : 53, 66, 3);\n    text(\"A/B RETRY\", 49, 76, 2);\n  }\n}\n",
  "canvas": {
    "width": 160,
    "height": 144
  },
  "palette": {
    "model": "indexed",
    "colors": [
      "#000000",
      "#555555",
      "#aaaaaa",
      "#ffffff"
    ]
  }
}
