{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../../packages/core/src/index.ts"],
  "tsconfig": "../../packages/core/tsconfig.json",
  "out": "dist",
  "name": "tynt",
  "favicon": "../web/public/tynt-mark.svg",
  "readme": "content/overview.md",
  "projectDocuments": [
    "content/getting-started.md",
    "generated/cartridge-api.md",
    "content/examples.md",
    "content/cartridge-files.md",
    "content/publishing.md",
    "content/security.md"
  ],
  "searchInDocuments": true,
  "navigation": {
    "includeCategories": true,
    "includeGroups": true,
    "includeFolders": false,
    "compactFolders": true
  },
  "customCss": "theme.css",
  "hideGenerator": true,
  "disableSources": true,
  "excludeInternal": true,
  "cleanOutputDir": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "invalidLink": true,
    "notDocumented": true,
    "notExported": true
  }
}
